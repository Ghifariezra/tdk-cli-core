{
  "group": "resource-types",
  "suite": "bring-your-own",
  "description": "A bring-your-own app, job, pair or Python service in each byoVariant on its own check: example (the container alone), flisk (through flisk up and Traefik with Flisk's Postgres), job (a one-shot through flisk up), pair (a dependency and an app through flisk up), python-dry-run (the resource contract and up --dry-run, no Docker) and python-boot (the Python fixture boots and answers its health route). The matrix runs one leg per variant (#1297).",
  "paths": [
    "docs/byo.md",
    "cli/src/commands/resource.ts",
    "engine/**",
    "tests/e2e/lib/**",
    "tests/e2e/resource-types/bring-your-own/**",
    ".github/workflows/e2e-resource-types.yml",
    "examples/byo/**",
    "examples/byo-jobs/**",
    "cli/src/commands/up.ts",
    "engine/schemas/service-schema.json",
    "tests/e2e/fixtures/byo-python-health/**"
  ],
  "cases": [
    "BY1",
    "BY2",
    "BY3",
    "BY4",
    "BY5",
    "BY6"
  ],
  "variants": [
    {
      "id": "example",
      "case": "BY1",
      "args": "echo /health"
    },
    {
      "id": "example-lobster",
      "case": "BY1",
      "args": "lobster /health"

    },
    {
      "id": "example-goose",
      "case": "BY1",
      "args": "goose /health"
    },
    {
      "id": "flisk",
      "case": "BY2",
      "args": "full-stack-fastapi-template /api/v1/utils/health-check/"
    },
    {
      "id": "job",
      "case": "BY3",
      "args": "dbmate"
    },
    {
      "id": "pair",
      "case": "BY4",
      "args": "turso 4500 /health turso-app LIBSQL_URL /health"
    },
    {
      "id": "python-dry-run",
      "case": "BY5",
      "args": ""
    },
    {
      "id": "python-boot",
      "case": "BY6",
      "args": ""
    }
  ],
  "triggers": [
    "pr",
    "nightly",
    "manual"
  ],
  "timeoutMinutes": 30,
  "needsSecrets": []
}
