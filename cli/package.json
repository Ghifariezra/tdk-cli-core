{
  "name": "tdk-cli-internal",
  "private": true,
  "version": "1.3.207",
  "description": "Flisk CLI — start services on your machine.",
  "keywords": [
    "flisk",
    "tilt",
    "cli",
    "local-dev",
    "microservices"
  ],
  "homepage": "https://github.com/flisk-sh/flisk#readme",
  "bugs": {
    "url": "https://github.com/flisk-sh/flisk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/flisk.git",
    "directory": "cli"
  },
  "license": "MIT",
  "author": "Flisk Team",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flisk": "bin/tdk.js"
  },
  "files": [
    "dist",
    "dist-bundle",
    "bin",
    "templates",
    "README.md",
    "Tiltfile",
    "engine",
    "discovery",
    "specs",
    "ext",
    "!ext/ide-components/code_executor",
    "shared-platform-engineering/docker-templates"
  ],
  "scripts": {
    "build": "tsc && node scripts/bundle.mjs",
    "build:watch": "tsc --watch",
    "check:dist": "npm run build && ../scripts/check-cli-dist.sh",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "dev": "bun run build:watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.reportOnFailure --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary --coverage.reporter=json --coverage.reportsDirectory=coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
    "prepack": "../scripts/stage-npm-engine.sh && npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "^8.17.1",
    "chalk": "^6.0.1",
    "esbuild": "^0.28.2",
    "ink": "^8.0.0",
    "knip": "^6.38.0",
    "react": "^19.3.0",
    "react-devtools-core": "^8.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
