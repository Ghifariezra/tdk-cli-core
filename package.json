{
  "name": "@flisk-sh/flisk",
  "version": "1.3.207",
  "description": "Flisk CLI — start services on your machine.",
  "homepage": "https://flisk.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flisk-sh/flisk.git"
  },
  "bugs": {
    "url": "https://github.com/flisk-sh/flisk/issues"
  },
  "private": false,
  "workspaces": [
    "cli"
  ],
  "bin": {
    "flisk": "cli/bin/tdk.js"
  },
  "files": [
    "Tiltfile",
    "engine",
    "!engine/docs",
    "discovery",
    "specs",
    "ext",
    "!ext/ide-components/code_executor",
    "shared-platform-engineering/docker-templates",
    "examples/tdk-example",
    "cli/bin",
    "cli/dist/**/*.js",
    "cli/dist-bundle/**/*.js",
    "cli/templates",
    "cli/package.json",
    "cli/shared-platform-engineering/docker-templates",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "cd cli && npm run build",
    "build:watch": "cd cli && npm run build:watch",
    "typecheck": "cd cli && npm run typecheck",
    "lint": "cd cli && npm run lint",
    "lint:fix": "cd cli && npm run lint:fix",
    "test": "cd cli && npm run test",
    "clean": "cd cli && npm run clean",
    "release:binaries": "scripts/release-binaries.sh",
    "release:binaries:publish": "scripts/release-binaries.sh --publish",
    "prepack": "node cli/scripts/bundle.mjs",
    "postpack": "rm -rf cli/dist-bundle",
    "prepare": "scripts/install-git-hooks.sh",
    "cli": "cd cli && node bin/tdk.js",
    "flisk": "cd cli && node bin/tdk.js"
  },
  "keywords": [
    "flisk",
    "tilt",
    "cli",
    "microservices",
    "local-dev",
    "local-development",
    "developer-tools",
    "developer-experience",
    "docker",
    "docker-compose",
    "dev-environment",
    "monorepo",
    "hot-reload",
    "bun",
    "kubernetes-alternative",
    "docker-compose-alternative",
    "live-reload",
    "no-kubernetes",
    "service-orchestration",
    "tiltfile"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "chalk": "^6.0.1",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "@types/node": "^26.6.5",
    "knip": "^6.38.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
